{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "pretest": "prisma generate",
    "test": "cross-env NODE_ENV=test node ./node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:watch": "cross-env NODE_ENV=test node ./node_modules/jest/bin/jest.js --config jest.config.cjs --watch",
    "dev": "cross-env NODE_OPTIONS=--disable-warning=DEP0040 ts-node-dev src/server.ts",
    "build:prod": "npm run prisma:generate && NODE_ENV=production tsc -p tsconfig.build.json && cp -r src/tools/generated dist/tools/",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "deploy:prod": "npm run prisma:migrate:deploy && npm run start:prod",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "keywords": [],
  "author": "Fernando de Souza Arantes",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.0",
    "cross-env": "^10.1.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.3.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.4.0",
    "pg": "^8.16.3",
    "prisma": "^7.10.1",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7"
  },
  "overrides": {
    "js-yaml@>=3 <4": "3.15.2",
    "js-yaml@>=4 <5": "4.3.2",
    "body-parser@>=1 <2": "1.20.9",
    "body-parser@>=2 <3": "2.4.0",
    "proxy-addr": "2.0.8",
